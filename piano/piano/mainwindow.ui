  <property name="styleSheet">
   <string notr="true">QWidget#centralWidget {
    background-color: #eef1f6;
    background-image: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eef1f6, stop:1 #e3e9f5);
}
QMainWindow {
    background-color: #eef1f6;
}

/* ===== 通用按钮 ===== */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f5f7fa);
    color: #2c3e50;
    border: 1px solid #d6dae3;
    border-radius: 10px;
    padding: 8px 18px;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #eaf2ff, stop:1 #d6e6ff);
    border-color: #4a90e2;
    color: #1a73e8;
}
QPushButton:pressed {
    background-color: #d0e0ff;
    border-color: #1a73e8;
}
QPushButton:disabled {
    background-color: #eceef1;
    color: #9aa0a6;
    border-color: #d6dae3;
}

/* ===== 主操作按钮（渐变蓝） ===== */
QPushButton#pushButton_26,
QPushButton#pushButton_30,
QPushButton#pushButton_32,
QPushButton#pushButton_27,
QPushButton#pushButton_33 {
    color: #ffffff;
    border: 1px solid #2a5cd6;
    border-radius: 10px;
    font-weight: 600;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4a90e2, stop:0.5 #1a73e8, stop:1 #1557b8);
}
QPushButton#pushButton_26:hover,
QPushButton#pushButton_30:hover,
QPushButton#pushButton_32:hover,
QPushButton#pushButton_27:hover,
QPushButton#pushButton_33:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5aa0f2, stop:0.5 #2a83f0, stop:1 #1a67c8);
    border-color: #1557b8;
}
QPushButton#pushButton_26:pressed,
QPushButton#pushButton_30:pressed,
QPushButton#pushButton_32:pressed,
QPushButton#pushButton_27:pressed,
QPushButton#pushButton_33:pressed {
    background-color: #0f44a0;
}

/* ===== 危险按钮（停止播放 - 红色调） ===== */
QPushButton#pushButton_33 {
    color: #ffffff;
    border: 1px solid #b03a3a;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff7a7a, stop:0.5 #e84c4c, stop:1 #c93838);
}
QPushButton#pushButton_33:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ff8a8a, stop:0.5 #f05a5a, stop:1 #d34848);
    border-color: #b03a3a;
}
QPushButton#pushButton_33:pressed {
    background-color: #a02828;
}

/* ===== 次要动作按钮（描边） ===== */
