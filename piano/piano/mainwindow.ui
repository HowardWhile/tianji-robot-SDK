/* ===== 下拉框 ===== */
QComboBox {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f5f7fa);
    color: #2c3e50;
    border: 1px solid #d6dae3;
    border-radius: 10px;
    padding: 6px 14px;
    min-height: 28px;
    min-width: 180px;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 14px;
}
QComboBox:hover {
    border-color: #4a90e2;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #eaf2ff);
}
QComboBox::drop-down {
    border: none;
    width: 28px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #5a6473;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d6dae3;
    border-radius: 8px;
    outline: none;
    selection-background-color: #1a73e8;
    selection-color: #ffffff;
    padding: 4px;
}

/* ===== 菜单栏 / 工具栏 / 状态栏 ===== */
QMenuBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f5f7fa);
    color: #2c3e50;
    border-bottom: 1px solid #e6e9ef;
    padding: 3px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    border-radius: 6px;
    margin: 0 2px;
}
QMenuBar::item:selected {
    background-color: #eaf2ff;
    color: #1a73e8;
}
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e6e9ef;
    spacing: 4px;
}
QStatusBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f5f7fa, stop:1 #ffffff);
    color: #5a6473;
    border-top: 1px solid #e6e9ef;
}</string>
